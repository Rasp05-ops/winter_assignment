# DistilRoBERTa emotion classifier (7 emotions -> mapped to negative/neutral/positive)
TRANSFORMER_MODEL=j-hartmann/emotion-english-distilroberta-base
# 384-dim sentence embedding model used for pgvector semantic search
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Set to 0 to skip loading a model (fast local dev / CI)
ENABLE_TRANSFORMER=1
ENABLE_EMBEDDER=1

# Ensemble weight of the transformer; TF-IDF/LR gets (1 - weight). Re-normalised if a model is missing.
ENSEMBLE_WEIGHT_TRANSFORMER=0.7

TFIDF_MODEL_PATH=artifacts/tfidf_lr.joblib

# Optional shared secret. If set, callers must send header: X-API-Key
ML_SERVICE_API_KEY=
