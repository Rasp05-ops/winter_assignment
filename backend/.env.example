NODE_ENV=development
PORT=3001
DB_SYNC_ALTER=false

# --- PostgreSQL (needs the pgvector extension: use the pgvector/pgvector:pg16 image, or `CREATE EXTENSION vector`) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindbridge
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
CORS_ORIGINS=http://localhost:3000

# --- ML microservice (FastAPI) ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=
EMBEDDING_DIM=384
ML_INLINE_TIMEOUT_MS=3000      # how long journal creation waits for a score before moving on
ML_TIMEOUT_MS=15000
ML_BREAKER_THRESHOLD=3         # consecutive failures before the circuit opens
ML_BREAKER_COOLDOWN_MS=30000
ANALYSIS_RETRY_MS=60000        # background retry interval for entries not yet analysed
ANALYSIS_BATCH_SIZE=10
